#!name=SubViz Surge v0.1.41
#!desc=Subscription node visual analyzer local UI for Surge. v0.1.41 third-round structure patch: split maintainable source modules, add one-command bundle build, and keep the generated Surge single-file script.
#!category=Subscription

[General]
force-http-engine-hosts = %APPEND% subviz.store:0, subviz.localhost:0

[MITM]
hostname = %APPEND% subviz.store, subviz.localhost

[Host]
subviz.store = 198.18.0.1
subviz.localhost = 198.18.0.1

[Rule]
DOMAIN,subviz.store,DIRECT
DOMAIN,subviz.localhost,DIRECT

[Script]
SubVizText = type=http-request,pattern=^https?:\/\/(?:subviz\.store|subviz\.localhost)\/api\/analyze-text(?:\?|$),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/youniube/subviz/main/subviz.js,script-update-interval=60,timeout=60,debug=false

SubVizLanding = type=http-request,pattern=^https?:\/\/(?:subviz\.store|subviz\.localhost)\/api\/landing(?:\?|$),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/youniube/subviz/main/subviz.js,script-update-interval=60,timeout=90,debug=false,ability=http-client-policy

SubVizAvailability = type=http-request,pattern=^https?:\/\/(?:subviz\.store|subviz\.localhost)\/api\/availability(?:\?|$),requires-body=true,max-size=10485760,script-path=https://raw.githubusercontent.com/youniube/subviz/main/subviz.js,script-update-interval=60,timeout=60,debug=false,ability=http-client-policy

SubViz = type=http-request,pattern=^https?:\/\/(?:subviz\.store|subviz\.localhost)(?!\/api\/(?:analyze-text|landing|availability)(?:\?|$))(?:\/|$),requires-body=false,max-size=10485760,script-path=https://raw.githubusercontent.com/youniube/subviz/main/subviz.js,script-update-interval=60,timeout=60,debug=false
